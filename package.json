{
  "name": "dsh-autopilot",
  "version": "0.0.0",
  "description": "Turn approved tracker tickets into review-ready pull requests with DeepSeek Harness.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "verify:package": "node scripts/verify-package.mjs .artifacts/dsh-autopilot-0.0.0.tgz",
    "prepare": "pnpm run build",
    "prepack": "pnpm run typecheck && pnpm run test"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canhta/dsh-autopilot.git"
  },
  "bugs": {
    "url": "https://github.com/canhta/dsh-autopilot/issues"
  },
  "homepage": "https://github.com/canhta/dsh-autopilot#readme",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "aidlc",
    "automation"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
